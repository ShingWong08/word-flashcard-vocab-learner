# Copy this file to .env and fill in your own keys. Never commit .env.

# connectGenAI / connectGenAIRequest. There are no defaults in the code:
# every LLM_* line below must be filled in (or passed as an argument in code).
# Any OpenAI-compatible API works; the values below are for NVIDIA
# (https://build.nvidia.com), whose keys start with "nvapi-".
# The AI tutor needs LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, LLM_TOP_P and
# LLM_MAX_TOKENS; it passes its own system message and temperature.
LLM_API_KEY=
LLM_BASE_URL=https://socratic.cs.cityu.edu.hk/litellm/v1
LLM_MODEL=Socrates
LLM_SYSTEM_MESSAGE=You are an AI assistant.
LLM_TEMPERATURE=1.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=2000
# Only used by connectGenAIRequest:
LLM_REASONING_EFFORT=low
LLM_TIMEOUT=60

# speechToText / textToSpeech (ElevenLabs)
ELEVENLABS_API_KEY=

# Optional: where your flashcard deck is saved (default: ~/.word_flashcard/deck.json)
# WORD_FLASHCARD_DECK=C:\path\to\deck.json

# Optional: full path of tesseract.exe, if Tesseract OCR is not on PATH (used to import words from scans)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
