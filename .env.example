# Copy this file to .env and fill in your own keys. Never commit .env.

# connectGenAI / connectGenAIRequest (key for whichever LLM provider you use)
LLM_API_KEY=YOUR_LLM_API_KEY

# speechToText / textToSpeech (ElevenLabs)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY

# Optional: where your flashcard deck is saved (default: ~/.word_flashcard/deck.json)
# WORD_FLASHCARD_DECK=C:\path\to\deck.json

# Optional: full path of tesseract.exe, if Tesseract OCR is not on PATH (used to import words from scans)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
